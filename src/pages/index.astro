---
import Base from '../layouts/Base.astro';
import { getCopy } from '../content/site';

const t = getCopy();
---

<Base title={t.meta.title} description={t.meta.description}>
  <main class="grid min-h-screen place-items-center bg-royal text-white" data-surface="dark">
    <h1 class="text-h1">{t.brand.name}</h1>
  </main>
</Base>
