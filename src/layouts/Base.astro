---
import { Font } from 'astro:assets';
import '../styles/global.css';

import { getCopy, type Locale } from '../content/site';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Keep this page out of search results (e.g. /styleguide). */
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const t = getCopy(lang);
const url = new URL(Astro.url.pathname, Astro.site).href;
// og:image = the car photo poster with a taxi strip (npm run icons builds it from public/car-3d/dzire-poster-1200.webp).
const image = new URL('/og-image.jpg', Astro.site).href;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="theme-color" content="#072A66" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand.name} />
    <meta property="og:locale" content={`${lang}_IN`} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.car.posterAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={t.car.posterAlt} />
    <slot name="head" />
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      // Motion tier for CSS ([data-motion]) and src/scripts/motion.ts, set before first paint.
      // ?motion=full|lite|reduced forces a tier for QA.
      (function () {
        var n = navigator;
        var forced = new URLSearchParams(location.search).get('motion');
        document.documentElement.dataset.motion = /^(full|lite|reduced)$/.test(forced)
          ? forced
          : matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'reduced'
            : n.hardwareConcurrency <= 4 || (n.connection && n.connection.saveData)
              ? 'lite'
              : 'full';
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // GSAP ScrollTrigger and Lenis are registered together here so smooth scroll and scroll triggers share one clock.
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';
  import { gsap, ScrollTrigger, tier } from '../scripts/motion';

  // The Call button pulse ([data-pulse] in global.css) stops once the visitor first taps, clicks or types.
  const interacted = () => document.documentElement.setAttribute('data-interacted', '');
  addEventListener('pointerdown', interacted, { once: true });
  addEventListener('keydown', interacted, { once: true });

  if (tier === 'full') {
    // Touch keeps native scrolling (Lenis default). Anchor links stay native (CSS smooth + scroll-padding + focus).
    const lenis = new Lenis({ prevent: (node) => !!node.closest('dialog, [popover]') });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }
</script>
