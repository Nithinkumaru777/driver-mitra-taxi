---
// Photo grid + lightbox. Photos come from `npm run drivers` (scripts/drivers.mjs).
import { existsSync } from 'node:fs';
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import { getCopy, gallery, driversOnRoad, driverPhotoWidths, TBD } from '../../content/site';

const t = getCopy();
const lb = t.drivers.lightbox;

for (const d of gallery) {
  if (!existsSync(`public/drivers/${d.image}-640.webp`))
    throw new Error(`Driver photo "${d.image}" is missing. Put it in assets/drivers-original/ and run: npm run drivers`);
}

const srcset = (image: string, format: string) =>
  driverPhotoWidths.map((w) => `/drivers/${image}-${w}.${format} ${w}w`).join(', ');
// 2 columns on mobile, 4 from md; the container caps at 72rem.
const sizes = '(min-width: 1152px) 270px, (min-width: 768px) 23vw, 46vw';
// Counter split around the number so only the number counts up, whatever the word order of the locale.
const [counterPre, counterPost] = t.drivers.counter('{n}').split('{n}');
---

<section id="our-drivers" class="bg-royal-tint py-16 md:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-h2 text-royal">{t.drivers.heading}</h2>
        <p class="mt-3 max-w-xl text-lg text-ink-muted">{t.drivers.subline}</p>
      </div>
      {driversOnRoad !== TBD && (
        <Badge class="self-start px-4 py-2 text-xl md:shrink-0 md:self-auto">
          <span class="sr-only">{t.drivers.counter(driversOnRoad)}</span>
          <span aria-hidden="true">{counterPre}<span data-count>{driversOnRoad}</span>{counterPost}</span>
        </Badge>
      )}
    </div>
    <ul data-gallery class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {gallery.map((d, i) => (
        <li>
          <figure>
            <button type="button" data-index={i} aria-haspopup="dialog" class="group relative block w-full overflow-hidden rounded-card">
              <picture>
                <source type="image/avif" srcset={srcset(d.image, 'avif')} sizes={sizes} />
                <source type="image/webp" srcset={srcset(d.image, 'webp')} sizes={sizes} />
                <img
                  src={`/drivers/${d.image}-640.webp`}
                  alt={d.name === TBD ? t.drivers.photoComing : t.drivers.alt(d.name, d.city)}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                />
              </picture>
              <span aria-hidden="true" class="absolute inset-x-0 bottom-0 translate-y-full bg-royal-deep/90 px-3 py-2 text-left text-sm font-semibold text-white transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0">
                {d.name}{d.city !== TBD ? `, ${d.city}` : ''}
              </span>
            </button>
            <figcaption class="mt-3">
              <p class="font-semibold">{d.name}{d.city !== TBD ? `, ${d.city}` : ''}</p>
              {(d.plan !== TBD || d.handoverDate !== TBD) && (
                <p class="text-sm text-ink-muted">
                  {[d.plan !== TBD ? d.plan : '', d.handoverDate !== TBD ? d.handoverDate : ''].filter(Boolean).join(' | ')}
                </p>
              )}
              {d.quote && <blockquote class="mt-2 text-sm italic">“{d.quote}”</blockquote>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <dialog
    data-lightbox
    aria-label={t.drivers.heading}
    data-surface="dark"
    class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink text-white backdrop:bg-transparent"
  >
    <div class="grid h-full grid-rows-[auto_1fr_auto]">
      <div class="flex justify-end p-3">
        <button type="button" data-close aria-label={lb.close} class="grid size-12 place-content-center rounded-full hover:bg-white/10">
          <X size={28} aria-hidden="true" />
        </button>
      </div>
      <div data-stage class="flex min-h-0 items-center justify-center px-4"></div>
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <button type="button" data-prev aria-label={lb.previous} class="grid size-12 shrink-0 place-content-center rounded-full bg-white/10 hover:bg-white/20">
          <ChevronLeft size={28} aria-hidden="true" />
        </button>
        <div data-caption aria-live="polite" class="text-center"></div>
        <button type="button" data-next aria-label={lb.next} class="grid size-12 shrink-0 place-content-center rounded-full bg-white/10 hover:bg-white/20">
          <ChevronRight size={28} aria-hidden="true" />
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* Cloned grid captions use text-ink-muted; on the dark lightbox inherit white instead. */
  [data-caption] :global(*) {
    color: inherit;
  }
  :global(html:has([data-lightbox][open])) {
    overflow: hidden;
  }
  :global(::view-transition-group(driver-photo)) {
    animation-duration: 350ms;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>

<script>
  // Native <dialog>: focus trap, Esc to close and focus return come for free.
  import { gsap, tier, countUp, onceVisible } from '../../scripts/motion';

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const stage = dialog.querySelector<HTMLElement>('[data-stage]')!;
  const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
  const figures = [...document.querySelectorAll<HTMLElement>('[data-gallery] figure')];
  let index = 0;

  // Reuse the grid's <picture> (same srcset, already-cached files) instead of duplicating the data.
  const show = (i: number) => {
    index = (i + figures.length) % figures.length;
    const picture = figures[index].querySelector('picture')!.cloneNode(true) as HTMLElement;
    picture.className = 'contents';
    picture.querySelectorAll('source, img').forEach((el) => el.setAttribute('sizes', '100vw'));
    const img = picture.querySelector('img')!;
    img.loading = 'eager';
    img.className = 'size-auto max-h-full max-w-full rounded-card';
    stage.replaceChildren(picture);
    caption.replaceChildren(...figures[index].querySelector('figcaption')!.cloneNode(true).childNodes);
  };

  // Shared-element expand: the View Transitions API morphs the grid photo into the lightbox photo and back.
  // Browsers without it (or reduced motion) just open and close.
  const PHOTO = 'driver-photo';
  const thumb = (i: number) => figures[i].querySelector('img')!;
  const stageImg = () => stage.querySelector('img')!;
  const morph = async (update: () => unknown) => {
    if (!document.startViewTransition || tier === 'reduced') return void (await update());
    await document.startViewTransition(update).finished;
  };

  const open = (i: number) => {
    thumb(i).style.viewTransitionName = PHOTO;
    morph(async () => {
      thumb(i).style.viewTransitionName = '';
      show(i);
      dialog.showModal();
      stageImg().style.viewTransitionName = PHOTO;
      // Wait (briefly) for the bigger srcset candidate so the morph doesn't land on an empty frame.
      await Promise.race([stageImg().decode().catch(() => {}), new Promise((r) => setTimeout(r, 250))]);
    });
  };
  const close = async () => {
    const back = thumb(index);
    stageImg().style.viewTransitionName = PHOTO;
    await morph(() => {
      stageImg().style.viewTransitionName = '';
      dialog.close();
      back.style.viewTransitionName = PHOTO;
    });
    back.style.viewTransitionName = '';
  };

  document.querySelector('[data-gallery]')!.addEventListener('click', (e) => {
    const button = (e.target as Element).closest<HTMLElement>('[data-index]');
    if (button) open(Number(button.dataset.index));
  });

  dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
  dialog.querySelector('[data-close]')!.addEventListener('click', close);
  // Tap on the empty area around the photo closes it.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === stage) close();
  });
  // Esc: animate the close too.
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // Swipe: one-finger horizontal drag of 50px+. Multi-touch (pinch zoom) is ignored.
  let x0 = NaN;
  let y0 = NaN;
  stage.addEventListener('touchstart', (e) => {
    [x0, y0] = e.touches.length === 1 ? [e.touches[0].clientX, e.touches[0].clientY] : [NaN, NaN];
  }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    const dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    x0 = NaN;
  });

  // Counter + staggered reveal of the grid.
  countUp(document.querySelector<HTMLElement>('#our-drivers [data-count]')!);
  if (tier !== 'reduced') {
    const items = document.querySelectorAll('[data-gallery] > li');
    gsap.set(items, { opacity: 0, y: tier === 'full' ? 28 : 8 });
    onceVisible(items, (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.5, stagger: 0.08, ease: 'power2.out' }));
  }
</script>
