---
// Static grid. Phase 4 adds the image pipeline (srcset) and the lightbox.
import { Camera } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import { getCopy, gallery, driversOnRoad } from '../../content/site';

const t = getCopy();
---

<section id="our-drivers" class="bg-royal-tint py-16 md:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-h2 text-royal">{t.drivers.heading}</h2>
        <p class="mt-3 max-w-xl text-lg text-ink-muted">{t.drivers.subline}</p>
      </div>
      <Badge class="self-start px-4 py-2 text-xl md:shrink-0 md:self-auto">{t.drivers.counter(driversOnRoad)}</Badge>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {gallery.map((d) => (
        <li>
          <figure>
            {d.image ? (
              <img
                src={`/drivers/${d.image}`}
                alt={t.drivers.alt(d.name, d.city)}
                loading="lazy"
                class="aspect-[4/5] w-full rounded-card object-cover"
              />
            ) : (
              <div class="grid aspect-[4/5] place-content-center justify-items-center gap-2 rounded-card border-2 border-dashed border-royal/30 bg-white p-3 text-center text-ink-muted">
                <Camera size={32} aria-hidden="true" />
                <span class="text-sm">{t.drivers.photoComing}</span>
              </div>
            )}
            <figcaption class="mt-3">
              <p class="font-semibold">{d.name}, {d.city}</p>
              <p class="text-sm text-ink-muted">{d.plan} | {d.handoverDate}</p>
              {d.quote && <blockquote class="mt-2 text-sm italic">“{d.quote}”</blockquote>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
