---
import { ChevronDown } from '@lucide/astro';
import { getCopy } from '../../content/site';

const t = getCopy();
---

<section aria-labelledby="faq-heading" class="bg-white py-16 md:py-24">
  <div class="container-page">
    <h2 id="faq-heading" class="text-h2 text-royal">{t.faq.heading}</h2>
    <div class="mt-8 max-w-3xl divide-y divide-royal-tint border-y border-royal-tint">
      {t.faq.items.map((item) => (
        <details name="faq" class="group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {item.q}
            <ChevronDown size={24} class="shrink-0 text-royal transition-transform group-open:rotate-180" aria-hidden="true" />
          </summary>
          <p class="pb-5 text-ink-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
