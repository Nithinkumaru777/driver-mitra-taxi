---
import { Phone, MessageCircle, MapPin, Mail } from '@lucide/astro';
import Checkered from '../ui/Checkered.astro';
import { getCopy, contact, TBD } from '../../content/site';

const t = getCopy();
const rows = [
  { icon: MessageCircle, label: t.contact.whatsapp, value: contact.whatsapp === TBD ? TBD : `+${contact.whatsapp}` },
  { icon: MapPin, label: t.contact.address, value: contact.address },
  { icon: Mail, label: t.contact.email, value: contact.email },
];
---

<footer id="contact" data-surface="dark" class="bg-royal-deep text-white">
  <Checkered />
  <!-- Bottom padding keeps footer links clear of the mobile bar and floating WhatsApp button. -->
  <div class="container-page pb-[calc(7rem+env(safe-area-inset-bottom))] pt-16 md:pb-28 md:pt-24">
    <h2 class="text-h2">{t.contact.heading}</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <ul class="space-y-6">
        <li class="flex gap-4">
          <Phone size={24} class="mt-1 shrink-0 text-taxi" aria-hidden="true" />
          <div>
            <p class="text-mist">{t.contact.call}</p>
            {contact.phones.map((p) => (
              <a href={`tel:${p.tel}`} class="block py-1 font-display text-h3 underline-offset-4 hover:underline">{p.display}</a>
            ))}
          </div>
        </li>
        {rows.map(({ icon: Icon, label, value }) => (
          <li class="flex gap-4">
            <Icon size={24} class="mt-1 shrink-0 text-taxi" aria-hidden="true" />
            <div>
              <p class="text-mist">{label}</p>
              <p class="font-semibold">{value}</p>
            </div>
          </li>
        ))}
      </ul>
      {contact.mapEmbedUrl === TBD ? (
        <div class="grid aspect-video place-content-center justify-items-center gap-2 rounded-card border-2 border-dashed border-mist/40 text-center text-mist">
          <MapPin size={32} aria-hidden="true" />
          <p>{t.contact.mapComing}</p>
        </div>
      ) : (
        <iframe
          title={t.contact.map}
          src={contact.mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="aspect-video w-full rounded-card shadow-card"
        ></iframe>
      )}
    </div>

    <div class="mt-16 flex flex-col gap-6 border-t border-white/15 pt-8 lg:flex-row lg:items-center lg:justify-between">
      <p class="font-display text-h3 uppercase text-taxi">{t.brand.closing}</p>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-mist">
          {t.nav.items.map((item) => (
            <li><a href={item.href} class="inline-block py-1 hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="mt-8 text-sm text-mist">{t.footer.copyright(new Date().getFullYear())}</p>
  </div>
</footer>
