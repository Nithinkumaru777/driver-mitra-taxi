---
// Light "stage" with the 3D car (BRIEF §6). The poster <img> shows instantly and stays as the fallback;
// <model-viewer> JS is only imported once a stage is near the viewport and WebGL is available.
import { Box, Rotate3d } from '@lucide/astro';
import Button from './ui/Button.astro';
import { getCopy, carModel } from '../content/site';

interface Props {
  class?: string;
  /** Above-the-fold stage: load the poster eagerly. */
  eager?: boolean;
}

const { class: className, eager = false } = Astro.props;
const t = getCopy();
---

<div
  data-car-stage
  class:list={[
    'group relative isolate overflow-hidden rounded-card bg-linear-to-b from-royal-tint to-white',
    'after:absolute after:inset-x-0 after:bottom-0 after:-z-10 after:h-1/4 after:bg-royal-tint/60',
    className,
  ]}
>
  <img
    src={carModel.poster}
    alt={t.car.posterAlt}
    width="1200"
    height="900"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="absolute inset-0 size-full object-contain transition-opacity duration-500 group-data-[state=ready]:opacity-0"
  />
  <model-viewer
    src={carModel.src}
    alt={t.car.modelLabel}
    loading="lazy"
    camera-controls
    disable-pan
    auto-rotate
    auto-rotate-delay="3000"
    rotation-per-second="25deg"
    interaction-prompt="none"
    camera-orbit="-35deg 75deg auto"
    min-camera-orbit="auto 40deg auto"
    max-camera-orbit="auto 88deg auto"
    environment-image="neutral"
    exposure="0.8"
    shadow-intensity="1"
    shadow-softness="1"
    ar
    ar-modes="webxr scene-viewer quick-look"
    class="absolute inset-0 size-full"
  >
    <Button slot="ar-button" icon={Box} size="md" class="absolute bottom-3 right-3 [model-viewer:not(:defined)_&]:hidden">
      {t.car.arButton}
    </Button>
  </model-viewer>

  <p
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-3 hidden -translate-x-1/2 items-center gap-1.5 rounded-full bg-royal-deep/85 px-3 py-1.5 text-sm font-semibold whitespace-nowrap text-white transition-opacity duration-500 group-data-[state=ready]:flex group-data-touched:opacity-0"
  >
    <Rotate3d size={16} aria-hidden="true" />{t.car.dragHint}
  </p>

  <div
    data-progress
    role="progressbar"
    aria-label={t.car.loading}
    aria-valuemin="0"
    aria-valuemax="100"
    hidden
    class="absolute inset-x-6 bottom-4 h-1.5 overflow-hidden rounded-full bg-royal/15 group-data-[state=error]:hidden group-data-[state=ready]:hidden"
  >
    <div class="h-full origin-left scale-x-0 bg-royal transition-transform duration-200"></div>
  </div>
</div>

<script>
  const stages = [...document.querySelectorAll<HTMLElement>('[data-car-stage]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fail = (stage: HTMLElement) => {
    stage.dataset.state = 'error';
    stage.querySelector('model-viewer')?.remove(); // poster stays as the fallback
  };

  let hasWebGL = false;
  try {
    hasWebGL = !!document.createElement('canvas').getContext('webgl2');
  } catch {}

  if (hasWebGL) {
    for (const stage of stages) {
      const viewer = stage.querySelector('model-viewer')!;
      const bar = stage.querySelector<HTMLElement>('[data-progress]')!;
      if (reducedMotion) viewer.removeAttribute('auto-rotate');

      viewer.addEventListener('progress', (e: Event) => {
        const p = (e as CustomEvent<{ totalProgress: number }>).detail.totalProgress;
        bar.hidden = false;
        bar.setAttribute('aria-valuenow', String(Math.round(p * 100)));
        (bar.firstElementChild as HTMLElement).style.transform = `scaleX(${p})`;
      });
      viewer.addEventListener('load', () => (stage.dataset.state = 'ready'));
      viewer.addEventListener('error', () => fail(stage));
      viewer.addEventListener('camera-change', (e) => {
        if ((e as CustomEvent<{ source: string }>).detail.source === 'user-interaction') stage.dataset.touched = '';
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        import('@google/model-viewer').catch(() => stages.forEach(fail));
      },
      { rootMargin: '300px' },
    );
    stages.forEach((s) => observer.observe(s));
  }
</script>
